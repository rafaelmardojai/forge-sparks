{
    "compilerOptions": {
        "target": "es2020",
        "module": "es2020",
        "moduleResolution": "bundler",

        "lib": ["es2021"],
        "types": [
            "@girs/gjs",
            "@girs/gjs/dom",
            "@girs/gio-2.0",
            "@girs/glib-2.0",
            "@girs/gtk-4.0",
            "@girs/adw-1",
            "@girs/soup-3.0",
            "@girs/secret-1",
            "@girs/xdp-1.0",
            "@girs/xdpgtk4-1.0",
        ],

        "allowJs": true,
        "checkJs": true,
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "sourceMap": true,
    },
    "include": ["src"],
    "exclude": ["node_modules"],
}
